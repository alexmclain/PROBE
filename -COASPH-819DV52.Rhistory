library(probe)
library(devtools)
load_all("PROBE/probe")
library(probe)
# ─────────────────────────────────────────────────────────
# PROBE (homoscedastic)
# ─────────────────────────────────────────────────────────
data(Sim_data)       # loads Sim_data list; use $ to access elements
data(Sim_data_test)
Y      <- Sim_data$Y;       X      <- Sim_data$X
Y_test <- Sim_data_test$Y_test; X_test <- Sim_data_test$X_test
beta_tr   <- Sim_data$beta_tr
sigma2_tr <- Sim_data$sigma2_tr
signal    <- Sim_data$signal   # indices of true non-nulls
# n=400, M=10000, M1=100 true signals, sigma2_tr=400
cat("── PROBE run ──\n")
full_res <- probe(Y = Y, X = X, Y_test = Y_test, X_test = X_test,
verbose = TRUE, alpha = 0.05, plot_ind = TRUE,
adj = 5)
cat("conv (0=OK):", full_res$conv, "\n")
cat("iterations: ", full_res$count, "\n")
cat("sigma2_est: ", round(full_res$sigma2_est, 2), " (true:", sigma2_tr, ")\n")
pred <- predict_probe_func(full_res, X = X_test)
cat("test RMSE:  ", round(sqrt(mean((Y_test - pred$Pred)^2)), 4), "\n")
cat("PI coverage:", round(mean(Y_test > pred$PI_L & Y_test < pred$PI_U), 3),
" (nominal 0.95)\n")
# Variable selection summary
g <- full_res$gamma_hat
cat("TP (gamma>0.5):", sum(g[signal] > 0.5), "/", length(signal), "\n")
cat("FP (gamma>0.5):", sum(g[-signal] > 0.5), "\n")
