# Run the analysis. eta_i (true signal) and signal are included for plotting purposes only.
full_res <- probe( Y = Y, X = X, Z = Z, alpha = alpha, plot_ind = plot_ind, signal = signal, eta_i  = eta_i)
# Final estimates of the impact of Z versus the true values:
data.frame(true_values = beta_Z_tr, full_res$Calb_mod$res_data[-2,])
#Compare to a standard linear model of X on Y:
summary(lm(Y~Z$Cont_cov + Z$Binary_cov))$coefficients
